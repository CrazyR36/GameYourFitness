# Vorlage fuer backend/.env — kopieren und Werte setzen:
#   cp backend/.env.example backend/.env
#
# ACHTUNG: Die unten stehenden Beispielwerte sind oeffentlich im Repo und
# NUR fuer lokale Entwicklung und CI gedacht. Fuer den Server (Issue #13)
# muessen JWT_SECRET, POSTGRES_PASSWORD, ANON_KEY, SERVICE_ROLE_KEY und
# SECRET_KEY_BASE zwingend neu erzeugt werden.
# ANON_KEY/SERVICE_ROLE_KEY sind HS256-JWTs, signiert mit JWT_SECRET
# (Payload: {"iss":"supabase-local","role":"anon|service_role","exp":1983812996}).
# Der SERVICE_ROLE_KEY gehoert niemals in die Android-App.

############
# Postgres
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
# Lokaler Port-Forward (nur 127.0.0.1)
POSTGRES_PORT=54322

############
# JWT / API-Schluessel
############
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJhbm9uIiwiZXhwIjoxOTgzODEyOTk2fQ.03kRoHS7CyhlnnUN3ys_b4xqbK7gkdACm0R-gyCpoo8
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJleHAiOjE5ODM4MTI5OTZ9.CvGPVcSrdWNqg71tF_g4YKevVDnN4F2WdoXh3ce0T7k

############
# Realtime
############
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

############
# URLs
############
# Oeffentliche API-Adresse (lokal: Caddy auf Port 8000)
API_EXTERNAL_URL=http://localhost:8000
API_PORT=8000
# Von GoTrue fuer Redirects verwendet
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

############
# Studio (nur 127.0.0.1)
############
STUDIO_PORT=54323
