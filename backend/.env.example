# Vorlage fuer backend/.env — kopieren und Werte setzen:
#   cp backend/.env.example backend/.env
#
# ACHTUNG: Die unten stehenden Beispielwerte sind die OEFFENTLICH BEKANNTEN
# Supabase-Demo-Schluessel. Sie sind NUR fuer lokale Entwicklung und CI gedacht.
# Fuer den Server (Issue #13) muessen JWT_SECRET, POSTGRES_PASSWORD, ANON_KEY,
# SERVICE_ROLE_KEY und SECRET_KEY_BASE zwingend neu erzeugt werden.
# Der SERVICE_ROLE_KEY gehoert niemals in die Android-App.

############
# Postgres
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
# Lokaler Port-Forward (nur 127.0.0.1)
POSTGRES_PORT=54322

############
# JWT / API-Schluessel
############
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
